{
  "name": "novelread",
  "displayName": "novelRead",
  "description": "在 VS Code 底部面板阅读本地小说：导入 txt、自动分章、记录阅读进度与每本书独立的阅读配置。",
  "version": "0.0.1",
  "publisher": "wumoin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "reader",
    "小说",
    "阅读器",
    "txt"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "novelRead",
          "title": "小说阅读器",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "novelRead": [
        {
          "type": "webview",
          "id": "novelRead.readerView",
          "name": "阅读器"
        }
      ]
    },
    "commands": [
      {
        "command": "novelRead.importNovel",
        "title": "导入小说",
        "category": "novelRead",
        "icon": "$(add)"
      },
      {
        "command": "novelRead.openReader",
        "title": "打开阅读器",
        "category": "novelRead",
        "icon": "$(book)"
      },
      {
        "command": "novelRead.refreshShelf",
        "title": "刷新书架",
        "category": "novelRead",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelRead.importNovel",
          "when": "view == novelRead.readerView",
          "group": "navigation@1"
        },
        {
          "command": "novelRead.refreshShelf",
          "when": "view == novelRead.readerView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "novelRead",
      "properties": {
        "novelRead.defaults.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 10,
          "maximum": 40,
          "description": "新导入小说的默认正文字号（px）。"
        },
        "novelRead.defaults.lineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1,
          "maximum": 3,
          "description": "新导入小说的默认行高倍数。"
        },
        "novelRead.defaults.maxWidth": {
          "type": "number",
          "default": 760,
          "minimum": 320,
          "description": "正文最大宽度（px），超过后居中留白。"
        },
        "novelRead.defaults.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "sepia",
            "dark"
          ],
          "default": "auto",
          "description": "新导入小说的默认阅读主题。"
        },
        "novelRead.reader.autoSaveProgress": {
          "type": "boolean",
          "default": true,
          "description": "是否在滚动/切换章节时自动记录阅读进度。"
        },
        "novelRead.reader.progressSaveDelay": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "description": "停止滚动后延迟多久写入阅读进度（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && mocha --ui tdd --ignore out/test/extension.test.js \"out/test/**/*.test.js\"",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.9",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
